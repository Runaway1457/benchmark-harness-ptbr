# Provedores. Deixe vazio o que não for usar.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cache de respostas (conteúdo endereçado por modelo + prompt + item + seed).
PTBR_BENCHMARK_CACHE_PATH=.ptbr-benchmark-cache.sqlite

# Concorrência máxima por provedor.
PTBR_BENCHMARK_MAX_CONCURRENCY=4

# Nível de log.
PTBR_BENCHMARK_LOG_LEVEL=INFO
